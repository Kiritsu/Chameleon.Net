<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Chameleon.Net\Chameleon.Net.csproj" />
        <ProjectReference Include="..\..\src\Chameleon.Net.Extensions.Http\Chameleon.Net.Extensions.Http.csproj" />
        <!-- Loopback fingerprint server for end-to-end checks of every profile. -->
        <ProjectReference Include="..\..\tools\Chameleon.Net.Inspector\Chameleon.Net.Inspector.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

    <ItemGroup>
        <!-- What real browsers sent, as the inspector reported it. -->
        <None Include="Inspector\Captures\*.jsonl" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <!-- Kestrel: a real HTTP/2 server to test against. -->
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
      <!-- Compiles the inspector's exported C# profiles. -->
      <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
      <PackageReference Include="Microsoft.NET.Test.Sdk" />
      <PackageReference Include="xunit.runner.visualstudio">
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        <PrivateAssets>all</PrivateAssets>
      </PackageReference>
      <PackageReference Include="xunit.v3" />
    </ItemGroup>
</Project>
