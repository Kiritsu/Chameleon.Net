<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>Chameleon.Net</PackageId>
        <Description>HttpClient handler and WebSocket connector whose TLS ClientHello, HTTP/2 frames and HTTP headers match a real client (OkHttp on Android, Chromium, Edge, Firefox). TLS by BouncyCastle.</Description>
        <PackageTags>tls;ja3;ja4;fingerprint;http2;okhttp;chrome;firefox;websocket;bouncycastle</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BouncyCastle.Cryptography" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="ZstdSharp.Port" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Chameleon.Net.Tests" />
    </ItemGroup>
</Project>
